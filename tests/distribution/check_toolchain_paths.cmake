# Reproduce a native GitHub Windows checkout path without running a compiler.
set(LLVM_MINGW [=[D:\a\CLPP\CLPP\toolchain]=])
include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/toolchains/llvm-mingw-x86_64.cmake")
foreach(tool CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_RC_COMPILER)
  string(FIND "${${tool}}" "\\" native_separator)
  if(NOT native_separator EQUAL -1)
    message(FATAL_ERROR "${tool} retains an unsafe CMake string escape: ${${tool}}")
  endif()
  string(FIND "${${tool}}" "D:/a/CLPP/CLPP/toolchain/bin/" prefix)
  if(NOT prefix EQUAL 0)
    message(FATAL_ERROR "${tool} changed the supplied toolchain root: ${${tool}}")
  endif()
endforeach()
message(STATUS "Native Windows toolchain separators normalized")
