CompileFlags:
  Add:
    - -std=c++20
    - -Wall
    - -Wextra
  CompilationDatabase: build/ucrt64
  Remove:
    - --param=*

Diagnostics:
  ClangTidy:
    Add:
      - performance-*
      - modernize-*
      - bugprone-*
    Remove: modernize-use-trailing-return-type

---
# Catch2 expands assertions into do/while and static test functions. These style
# checks diagnose framework-generated code rather than the behavior under test.
If:
  PathMatch: tests/.*
CompileFlags:
  Add: -Wno-c2y-extensions
Diagnostics:
  ClangTidy:
    Remove:
      - cppcoreguidelines-avoid-do-while
      - misc-use-anonymous-namespace
      - readability-function-cognitive-complexity
