#include <clpp/roblox.clh>

struct VideCounter {
    void Mount(PlayerGui playerGui);
};

void VideCounter::Mount(PlayerGui playerGui) {
    auto create = Vide.create;
    auto source = Vide.source;
    auto apply = Vide.apply;
    auto count = source(0);

    auto makeGui = create("ScreenGui");
    auto makeButton = create("TextButton");
    auto makeLabel = create("TextLabel");

    auto label = makeLabel({
        {"BackgroundTransparency", 1},
        {"Size", UDim2.fromScale(1, 0.5)},
        {"TextColor3", Color3.fromRGB(240, 240, 255)},
        {"Text", func () {
            return "Clicks: " .: count();
        }}
    });

    auto button = makeButton({
        {"Size", UDim2.fromScale(1, 0.5)},
        {"Position", UDim2.fromScale(0, 0.5)},
        {"Text", "Click"},
        {"Activated", func () {
            count(count() + 1);
        }}
    });

    auto gui = makeGui({
        {"Name", "VideCounter"},
        {"ResetOnSpawn", false},
        {"Parent", playerGui}
    });

    auto mount = apply(gui);
    mount({ label, button });
}

void init() {
    Players players = GetService<Players>();
    Player localPlayer = players.LocalPlayer;
    guard (localPlayer != null) else {
        return;
    }

    PlayerGui playerGui = localPlayer.WaitForChild("PlayerGui");
    VideCounter counter;
    counter.Mount(playerGui);
}
