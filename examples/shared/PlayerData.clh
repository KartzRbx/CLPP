#pragma once

#include <clpp/datatypes.clh>

struct PlayerDataCurrencies {
    int Coins = 0;
    int Rebirths = 0;
};

struct PlayerDataInventory {
    array<int> HotBar;
    array<int> Storage;
    
    int MaxStorage = 90;
};

struct PlayerData {
    PlayerDataCurrencies Currencies;
    PlayerDataInventory Inventory;
};
