#pragma once

#include <clpp/datatypes.clh>

struct PlayerDataCurrencies {
    int Coins = 0;
    int Rebirths = 0;
};

struct PlayerDataInventory {
    LuaArray<int> HotBar;
    LuaArray<string> Storage;
