// Windows resources for clpp.exe: application icon and version information.
#include <winver.h>

1 ICON "../../assets/brand/clpp.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,10,0,0
PRODUCTVERSION 0,10,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "CL++"
      VALUE "FileDescription", "CL++ compiler, VM and language server"
      VALUE "FileVersion", "0.10.0"
      VALUE "InternalName", "clpp"
      VALUE "OriginalFilename", "clpp.exe"
      VALUE "ProductName", "CL++"
      VALUE "ProductVersion", "0.10.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
