{
  "cmake.useCMakePresets": "always",
  "cmake.configurePreset": "ucrt64",
  "cmake.buildPreset": "ucrt64",
  "cmake.testPreset": "ucrt64",

  "clpp.serverPath": "",
  "discord.enabled": true,
  "discord.removeRemoteRepository": true,
  "discord.detailsEditing": "CL++ | {file_name}",
  "discord.detailsDebugging": "CL++ | {file_name}",
  "discord.lowerDetailsEditing": "Projeto: {workspace}",

  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.path": "clangd",
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--query-driver=C:/msys64/ucrt64/bin/g++.exe,C:/msys64/ucrt64/bin/gcc.exe",
    "--header-insertion=iwyu"
  ],

  "files.associations": {
    "*.clp": "clpp"
  },

  "[clpp]": {
    "editor.semanticHighlighting.enabled": true
  }
}
