{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CL++",
  "scopeName": "source.clpp",
  "patterns": [
    {
      "include": "#type-test"
    },
    {
      "include": "#comment-block"
    },
    {
      "include": "#comment-line"
    },
    {
      "include": "#string-float"
    },
    {
      "include": "#string-single"
    },
    {
      "include": "#string-template"
    },
    {
      "include": "#link"
    },
    {
      "include": "#declaration-method"
    },
    {
      "include": "#declaration-function"
    },
    {
      "include": "#declaration-type"
    },
    {
      "include": "#number-hex"
    },
    {
      "include": "#number-bin"
    },
    {
      "include": "#number"
    },
    {
      "include": "#language"
    },
    {
      "include": "#type"
    },
    {
      "include": "#typed-expression"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "#instance"
    },
    {
      "include": "#receiver"
    },
    {
      "include": "#member"
    },
    {
      "include": "#call"
    },
    {
      "include": "#type-name"
    },
    {
      "include": "#operator"
    }
  ],
  "repository": {
    "comment-block": {
      "name": "comment.block.clpp",
      "begin": "<<\\[",
      "end": "\\]>>"
    },
    "comment-line": {
      "name": "comment.line.clpp",
      "begin": "<<(?!\\[)",
      "end": "$"
    },
    "string-float": {
      "name": "string.quoted.float.clpp",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.clpp",
          "match": "\\\\."
        }
      ]
    },
    "string-single": {
      "name": "string.quoted.single.clpp",
      "begin": "'",
      "end": "'",
      "patterns": [
        {
          "name": "constant.character.escape.clpp",
          "match": "\\\\."
        }
      ]
    },
    "string-template": {
      "name": "string.quoted.other.template.clpp",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape.clpp",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.expression.clpp",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.clpp"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.clpp"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "number-hex": {
      "name": "constant.numeric.hex.clpp",
      "match": "\\b0[xX][0-9A-Fa-f_]+\\b"
    },
    "number-bin": {
      "name": "constant.numeric.binary.clpp",
      "match": "\\b0[bB][01_]+\\b"
    },
    "number": {
      "name": "constant.numeric.clpp",
      "match": "\\b\\d[\\d_]*(\\.[\\d_]+)?([eE][+-]?[\\d_]+)?\\b"
    },
    "language": {
      "name": "constant.language.clpp",
      "match": "\\b(true|false|null)\\b"
    },
    "type": {
      "name": "support.type.primitive.clpp",
      "match": "\\b(Vector2|Vector3|Vector4|array|dictionary|optional|tuple|auto|bool|buffer|float|number|string|task|void)\\b"
    },
    "keyword": {
      "patterns": [
        {
          "name": "storage.modifier.clpp",
          "match": "\\b(pragma|export|abstract|async|const|constexpr|def|template|typename|enum|class|extern|final|func|link|as|operator|override|private|public|static_cast|where|signal|observable|thread|atomic)\\b"
        },
        {
          "name": "keyword.control.clpp",
          "match": "\\b(await|break|continue|case|catch|default|else|for|guard|if|in|join|match|move|parallel|pcall|return|spawn|switch|try|do|while|and|or|not|shl|shr|decltype)\\b"
        },
        {
          "name": "support.function.builtin.clpp",
          "match": "\\b(post|warn|report|len|list|sort|find|push|pop|insert|remove|args|mutex|lock|unlock|fetch_add|atomic_load|actor)\\b"
        }
      ]
    },
    "operator": {
      "name": "keyword.operator.clpp",
      "match": "~>|\\.{3}|->|=>|\\+\\+|--|&&|\\|\\||==|!=|<=|>=|\\.:|::|\\.\\.|\\+|\\-|\\*|/|%|=|<|>|&|\\||\\^|~|\\?|:|\\.|!"
    },
    "link": {
      "match": "\\b(link)\\s+(@[A-Za-z_][\\w.]*)",
      "captures": {
        "1": {
          "name": "storage.modifier.clpp"
        },
        "2": {
          "name": "entity.name.namespace.clpp"
        }
      }
    },
    "declaration-method": {
      "match": "\\b(?!(?:pragma|export|abstract|async|const|constexpr|def|template|typename|enum|class|extern|final|func|link|as|operator|override|private|public|static_cast|where|thread|await|break|continue|case|catch|default|else|for|guard|if|in|join|match|move|parallel|pcall|return|spawn|switch|try|do|while|and|or|not|shl|shr|decltype)\\b)([A-Za-z_\\x{00C0}-\\x{024F}][\\w.\\x{00C0}-\\x{024F}]*(?:\\s*<[^;\\n(){}]+>)?)\\s+([A-Za-z_\\x{00C0}-\\x{024F}][\\w.\\x{00C0}-\\x{024F}]*)(?:\\s*<[^;\\n(){}]+>)?\\s*(::)\\s*([A-Za-z_\\x{00C0}-\\x{024F}][\\w\\x{00C0}-\\x{024F}]*)(?=\\s*\\()",
      "captures": {
        "1": { "name": "storage.type.clpp" },
        "2": { "name": "entity.name.type.clpp" },
        "3": { "name": "punctuation.accessor.clpp" },
        "4": { "name": "entity.name.function.member.clpp" }
      }
    },
    "declaration-function": {
      "match": "\\b(?!(?:pragma|export|abstract|async|const|constexpr|def|template|typename|enum|class|extern|final|func|link|as|operator|override|private|public|static_cast|where|thread|await|break|continue|case|catch|default|else|for|guard|if|in|join|match|move|parallel|pcall|return|spawn|switch|try|do|while|and|or|not|shl|shr|decltype)\\b)([A-Za-z_\\x{00C0}-\\x{024F}][\\w.\\x{00C0}-\\x{024F}]*(?:\\s*<[^;\\n(){}]+>)?)\\s+([A-Za-z_\\x{00C0}-\\x{024F}][\\w\\x{00C0}-\\x{024F}]*)(?=\\s*(?:::|\\())",
      "captures": {
        "1": {
          "name": "storage.type.clpp"
        },
        "2": {
          "name": "entity.name.function.clpp"
        }
      }
    },
    "declaration-type": {
      "match": "\\b(def|enum\\s+class)\\s+([A-Za-z_][\\w]*)(?:\\s*:\\s*([A-Za-z_][\\w]*(?:\\s*,\\s*[A-Za-z_][\\w]*)*))?",
      "captures": {
        "1": {
          "name": "storage.modifier.clpp"
        },
        "2": {
          "name": "entity.name.type.clpp"
        },
        "3": {
          "name": "entity.other.inherited-class.clpp"
        }
      }
    },
    "receiver": {
      "match": "(@)(this\\b|[A-Za-z_]\\w*)",
      "captures": {
        "1": {
          "name": "punctuation.accessor.instance.clpp"
        },
        "2": {
          "name": "variable.other.member.clpp"
        }
      }
    },
    "call": {
      "match": "\\b([A-Za-z_\\x{00C0}-\\x{024F}][\\w\\x{00C0}-\\x{024F}]*)\\s*(?=\\()",
      "name": "entity.name.function.call.clpp"
    },
    "type-name": {
      "match": "\\b_*[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.clpp"
    },
    "instance": {
      "name": "variable.language.this.clpp",
      "match": "@this\\b"
    },
    "member": {
      "patterns": [
        {
          "match": "(?<=[^.]\\.)\\s*([A-Za-z_\\x{00C0}-\\x{024F}][\\w\\x{00C0}-\\x{024F}]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.member.clpp"
            }
          }
        },
        {
          "match": "(?<=[^.]\\.)([A-Za-z_\\x{00C0}-\\x{024F}][\\w\\x{00C0}-\\x{024F}]*)",
          "captures": {
            "1": {
              "name": "variable.other.property.clpp"
            }
          }
        }
      ]
    },
    "typed-expression": {
      "match": "(?<=\\()\\s*(?!(?:pragma|export|abstract|async|const|constexpr|def|template|typename|enum|class|extern|final|func|link|as|operator|override|private|public|static_cast|where|thread|await|break|continue|case|catch|default|else|for|guard|if|in|join|match|move|parallel|pcall|return|spawn|switch|try|do|while|and|or|not|shl|shr|decltype)\\b)([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)?(?:\\s*<[^(){};]+>)?)\\s+(?=[A-Za-z_\"\\'0-9{])",
      "captures": {
        "1": {
          "name": "entity.name.type.clpp"
        }
      }
    },
    "type-test": {
      "match": "(:)(is)\\b(?=\\s*<)",
      "captures": {
        "1": {
          "name": "keyword.operator.clpp"
        },
        "2": {
          "name": "entity.name.function.member.clpp"
        }
      }
    }
  }
}
