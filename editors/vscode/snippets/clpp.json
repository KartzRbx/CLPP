{
  "fn": {
    "prefix": "fn",
    "body": ["${1:void} ${2:Name}($3) {", "\t$0", "}"],
    "description": "CL++ function"
  },
  "method": {
    "prefix": "method",
    "body": [
      "void ${1:Class}::${2:Method}($3) {",
      "\t@${4:janitor}.Add($0);",
      "}"
    ],
    "description": "Class::Method with @field (self.field)"
  },
  "init": {
    "prefix": "init",
    "body": [
      "void init() {",
      "\tPlayers players = GetService<Players>();",
      "\t$0",
      "}"
    ],
    "description": "Script init()"
  },
  "lambda": {
    "prefix": "lambda",
    "body": ["func ($1) {", "\t$0", "}"],
    "description": "CL++ func callback"
  },
  "atthis": {
    "prefix": "@this",
    "body": ["@this"],
    "description": "Receiver: current object (Luau self)"
  },
  "atfield": {
    "prefix": "@",
    "body": ["@${1:janitor}"],
    "description": "Receiver field: @name → self.name"
  },
  "guard": {
    "prefix": "guard",
    "body": ["guard ($1) else {", "\t$2", "\treturn;", "}"],
    "description": "Guard clause"
  },
  "observable": {
    "prefix": "obs",
    "body": [
      "observable ${1:int} ${2:coins} = ${3:0};",
      "${2}.OnChange(func (${1} newValue) {",
      "\tpost(\"$2: \" .: newValue);",
      "});"
    ],
    "description": "observable ValueBase"
  },
  "connect": {
    "prefix": "~>",
    "body": [
      "${1:players}.${2:PlayerAdded}~>Connect(func ($3) {",
      "\t$0",
      "});"
    ],
    "description": "Connect with auto-cleanup"
  },
  "once": {
    "prefix": "once",
    "body": [
      "${1:signal}~>Once(func ($2) {",
      "\t$0",
      "});"
    ],
    "description": "Once connection with auto-cleanup"
  },
  "fire": {
    "prefix": "fire",
    "body": ["${1:OnCoinsUpdated}.Fire($2);"],
    "description": "Fire a CL++ signal"
  },
  "changed": {
    "prefix": "changed",
    "body": [
      "${1:instance}.GetPropertyChangedSignal(\"${2:Name}\")~>Connect(func () {",
      "\t$0",
      "});"
    ],
    "description": "Property changed signal"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match ($1) {",
      "\t${2:Part} p => $3,",
      "\t_ => warn(\"unsupported\")",
      "};"
    ],
    "description": "Pattern match"
  },
  "foreach": {
    "prefix": "forin",
    "body": [
      "for (${1:Player} ${2:player} in ${3:players.GetPlayers()}) {",
      "\t$0",
      "}"
    ],
    "description": "Range-for: each value from a collection"
  },
  "include": {
    "prefix": "inc",
    "body": ["#include <clpp/roblox.clh>"],
    "description": "Include CL++ stdlib"
  }
}
