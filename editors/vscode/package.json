{
  "name": "clpp-language",
  "displayName": "CL++",
  "description": "CL++ language support for VS Code, Cursor, and compatible editors: highlighting, icon, and IntelliSense (.clpp / .clp / .clh)",
  "version": "0.7.1",
  "publisher": "clpp",
  "repository": {
    "type": "git",
    "url": "https://github.com/KartzRbx/CLPP"
  },
  "icon": "icons/clpp.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Programming Languages"],
  "keywords": ["clpp", "cl++", "luau", "roblox", "cluaupp", "cursor"],
  "activationEvents": ["onLanguage:clpp", "onLanguage:clpp-header"],
  "main": "./extension.js",
  "extensionKind": ["workspace", "ui"],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "clpp",
        "aliases": ["CL++", "clpp", "CLPP"],
        "extensions": [".clpp", ".clp", ".flare", ".mint", ".bloom", ".helm", ".shift", ".hive", ".axiom"],
        "filenamePatterns": ["*.server.clpp", "*.client.clpp", "*.plugin.clpp"],
        "icon": {
          "light": "./icons/clpp.png",
          "dark": "./icons/clpp.png"
        },
        "configuration": "./language-configuration.json"
      },
      {
        "id": "clpp-header",
        "aliases": ["CL++ Header", "clh"],
        "extensions": [".clh"],
        "icon": {
          "light": "./icons/clpp-header.svg",
          "dark": "./icons/clpp-header.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "clpp",
        "scopeName": "source.clpp",
        "path": "./syntaxes/clpp.tmLanguage.json"
      },
      {
        "language": "clpp-header",
        "scopeName": "source.clpp",
        "path": "./syntaxes/clpp.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "clpp.compileFile",
        "title": "CL++: Compile this file"
      },
      {
        "command": "clpp.showLuau",
        "title": "CL++: Show emitted Luau"
      },
      {
        "command": "clpp.restartLsp",
        "title": "CL++: Restart language server"
      }
    ],
    "snippets": [
      {
        "language": "clpp",
        "path": "./snippets/clpp.json"
      },
      {
        "language": "clpp-header",
        "path": "./snippets/clpp.json"
      }
    ],
    "configuration": {
      "title": "CL++",
      "properties": {
        "clpp.lens.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show CL++ errors as after-text decorations. Prefer the Problems panel or the Error Lens extension."
        },
        "clpp.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Use the CL++ language server (completions, hover, diagnostics from clpp api)."
        }
      }
    },
    "configurationDefaults": {
      "files.associations": {
        "*.clpp": "clpp",
        "*.clp": "clpp",
        "*.clh": "clpp-header",
        "*.flare": "clpp",
        "*.mint": "clpp",
        "*.bloom": "clpp",
        "*.helm": "clpp",
        "*.shift": "clpp",
        "*.hive": "clpp",
        "*.axiom": "clpp"
      },
      "[clpp]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.semanticHighlighting.enabled": true
      },
      "[clpp-header]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": false,
        "editor.semanticHighlighting.enabled": true
      }
    }
  }
}
