float Dist2(float ax, float ay, float az, float bx, float byy, float bz) {
    float dx = ax - bx;
    float dy = ay - byy;
    float dz = az - bz;
    return dx * dx + dy * dy + dz * dz;
}

float Damage(float base, float mult) {
    return base * mult;
}

float Hot(int n) {
    float acc = 0.0;
    for (int i = 0; i < n; i++) {
        acc = acc + Damage(Dist2(0.0, 0.0, 0.0, 1.0, 2.0, 3.0), 1.5);
    }
    return acc;
}
