{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Ninja Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Ninja Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "displayName": "Ninja Debug + ASan",
      "inherits": "debug",
      "cacheVariables": {
        "CLPP_SANITIZE_ADDRESS": "ON"
      }
    },
    {
      "name": "tidy",
      "displayName": "Ninja Debug + clang-tidy",
      "inherits": "debug",
      "cacheVariables": {
        "CLPP_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "ucrt64",
      "displayName": "Ninja Debug (MSYS2 UCRT64 GCC)",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/ucrt64-gcc.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tidy",
      "configurePreset": "tidy"
    },
    {
      "name": "ucrt64",
      "configurePreset": "ucrt64"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ucrt64",
      "configurePreset": "ucrt64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
